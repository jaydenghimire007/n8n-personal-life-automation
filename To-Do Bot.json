    {
      "parameters": {
        "jsCode": "const questText = $('Calculate EXP').first().json.questBoardText;\nconst stats = $('Merge Stats').all().map(item => item.json); // replace 'Merge Stats' with your actual node name\n\nlet statBlock = \"\\n\\n📊 STAT PROGRESS 📊\\n\";\nstats.forEach(s => {\n  const bar = \"█\".repeat(Math.floor(s.Progress / 100)) + \"░\".repeat(15 - Math.floor(s.Progress / 100));\n  statBlock += `${s.Stat}: Lv.${s.Level} [${bar}] +${s.gained} EXP\\n`;\n  if (s.leveledUp) {\n    statBlock += `🎉 LEVEL UP! ${s.Stat} reached Level ${s.Level}!\\n`;\n  }\n});\n\nreturn [{ json: { finalMessage: questText + statBlock } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        0
      ],
      "id": "8f62a456-af5f-45ec-8dc4-1f67c001fc20",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content[0].text;\n\nconst cleaned = raw\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst parsed = JSON.parse(cleaned);\n\nconst categories = [\"Strength\", \"Intelligence\", \"Social\", \"Vitality\", \"Discipline\"];\nconst gains = {};\ncategories.forEach(cat => gains[cat] = 0);\n\nparsed.events.forEach(event => {\n  const start = new Date(event.startTime);\n  const end = event.endTime ? new Date(event.endTime) : new Date(start.getTime() + 60 * 60000);\n  const minutes = Math.max(0, Math.round((end - start) / 60000));\n  if (gains[event.category] !== undefined) {\n    gains[event.category] += minutes;\n  }\n});\n\nreturn [{\n  json: {\n    questBoardText: parsed.questBoardText,\n    gains: gains\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        144
      ],
      "id": "51074e8e-f3eb-43a4-be6c-450dfec37f2b",
      "name": "Calculate EXP"
    },
    {
      "parameters": {
        "jsCode": "const previousData = $('Calculate EXP').first().json; // match this name to your actual node name\nconst currentStats = $input.all();\n\nconst LEVEL_SIZE = 1500;\n\nconst results = currentStats.map(row => {\n  const statName = row.json.Stat;\n  const currentTotal = parseInt(row.json.TotalEXP) || 0;\n  const gained = previousData.gains[statName] || 0;\n  const newTotal = currentTotal + gained;\n  const newLevel = Math.floor(newTotal / LEVEL_SIZE) + 1;\n  const progress = newTotal % LEVEL_SIZE;\n  const oldLevel = Math.floor(currentTotal / LEVEL_SIZE) + 1;\n\n  return {\n    json: {\n      Stat: statName,\n      TotalEXP: newTotal,\n      Level: newLevel,\n      Progress: progress,\n      gained: gained,\n      leveledUp: newLevel > oldLevel\n    }\n  };\n});\n\nreturn results;"
      },
