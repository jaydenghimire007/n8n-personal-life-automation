        "messages": {
          "values": [
            {
              "content": "=You are a nutrition and fitness logging assistant. The user will text you either a food/meal description or a body weight reading. Determine which it is and extract the relevant data.\n\nRules:\n- If it's food: estimate total calories for what they described, using typical/average values for those foods and typical portion sizes.\n- If it's a weight reading: extract the number as their weight (assume lbs unless they specify kg).\n- If the message contains both, extract both.\n\nRespond with ONLY valid JSON, no other text, no markdown code fences, in this exact structure:\n{\"type\": \"food\" or \"weight\" or \"both\", \"calories\": number or null, \"weight\": number or null, \"description\": \"short summary of what they logged\"}\n\nMessage: {{ $json.message.text }}"
            }
          ]
        },
        "options": {}
      },
