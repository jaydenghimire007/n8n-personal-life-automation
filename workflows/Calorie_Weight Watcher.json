      "parameters": {
        "jsCode": "const newEntry = $('Code in JavaScript').first().json; // reference your first Code node's output — rename if needed\nconst existingRows = $input.all();\nconst existing = existingRows.length > 0 ? existingRows[0].json : null;\n\nconst currentCalories = existing ? (existing.Calories || 0) : 0;\nconst newCalories = currentCalories + (newEntry.calories || 0);\n\nconst currentWeight = existing ? existing.Weight : null;\nconst finalWeight = newEntry.weight !== null ? newEntry.weight : currentWeight;\n\nconst currentLog = existing ? (existing.Log || \"\") : \"\";\nconst newLog = currentLog ? `${currentLog}; ${newEntry.description}` : newEntry.description;\n\nconst remaining = 3000 - newCalories;\n\nreturn [{\n  json: {\n    Date: newEntry.date,\n    Weight: finalWeight,\n    Calories: newCalories,\n    Log: newLog,\n    remaining: remaining\n  }\n}];"
      },
